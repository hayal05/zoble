# Copy this file to .env for local development, or set these as real
# environment variables in your deployment platform (e.g. Render's dashboard).

# Required in production. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Set to "production" on your deployed environment. Enables HTTPS-only
# cookies, HSTS, and enforces that SECRET_KEY must be set.
FLASK_ENV=development

# IMPORTANT for Render (or any host with an ephemeral filesystem):
# if these are left unset, the app falls back to a local SQLite file —
# which lives on Render's disk and gets WIPED on every redeploy/restart,
# taking all accounts, posts, and messages with it.
#
# Fix: use Turso (https://turso.tech), a hosted SQLite-compatible database
# with a genuinely permanent free tier.
#   1. Install the CLI and sign up free: https://docs.turso.tech/cli/installation
#   2. Create a database:      turso db create zoble
#   3. Get the URL:            turso db show zoble --url
#      (looks like: libsql://zoble-yourname.turso.io)
#   4. Create an auth token:   turso db tokens create zoble
#   5. Set both values below / in Render's Environment tab
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Legacy fallback: a plain Postgres/SQLAlchemy connection string. Only used
# if TURSO_DATABASE_URL above is NOT set. Not needed if you're using Turso.
DATABASE_URL=

# Optional. Render sets PORT automatically; only needed for manual runs.
PORT=5000

# Email verification (OTP) — used to send the 6-digit signup code, via
# the Brevo HTTP API (https://brevo.com). If BREVO_API_KEY or
# BREVO_FROM_EMAIL is left unset, the code is just logged to the server
# console instead of emailed, so local development works without a real
# API key.
#
# No domain purchase needed:
#   1. Sign up free at https://app.brevo.com (300 emails/day forever)
#   2. Settings -> Senders, Domains & Dedicated IPs -> Senders tab ->
#      Add a New Sender, using any email address you already own
#      (e.g. your Gmail address). Brevo emails a 6-digit code to that
#      inbox to confirm you control it.
#   3. Settings -> SMTP & API -> API Keys -> Generate a new API key
#   4. Set BREVO_API_KEY to that key, and BREVO_FROM_EMAIL to the
#      address you verified in step 2. You can then send to ANY
#      recipient, not just that address.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Zoble Chat

# Required, always — no local-dev exception. The app will not start
# without these three set (see the RuntimeError near CLOUDINARY_CONFIGURED
# in app.py). Image compression (resize + recompress) happens entirely
# on Cloudinary's side instead of this server's CPU/RAM — mirrors every
# upload to Cloudinary and serves images through Cloudinary's CDN
# transformations, so there is no local fallback path that could quietly
# burn this server's own memory/CPU on image processing.
#
#   1. Sign up free at https://cloudinary.com (25GB storage/bandwidth,
#      permanent free tier, no credit card)
#   2. On the dashboard home page, copy Cloud name, API Key, and API
#      Secret directly — no extra setup needed, unlike Brevo/Resend this
#      doesn't require verifying a sender or domain
#   3. Set the three values below
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
